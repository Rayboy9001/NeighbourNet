# NeighbourNet — environment variables
# Copy to `.env` for local development and fill in your own values.
# Never commit real secret values.

# --- Backend (server-side) ---
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"

# --- Frontend (exposed to the browser, publishable only) ---
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"

# --- Server-only secrets (NEVER put these in a committed file) ---
# Managed through the hosting platform's secret store, not this file.
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxx"
# LOVABLE_API_KEY="your-ai-gateway-key"
# ADMIN_CODE="choose-a-strong-admin-claim-code"
